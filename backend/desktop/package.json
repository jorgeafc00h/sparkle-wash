{
  "name": "sparklewash-desktop",
  "version": "1.0.0",
  "description": "SparkleWash — escritorio (punto de venta, lavado y facturación electrónica)",
  "private": true,
  "author": "SparkleWash",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "npm run build && electron-builder --config electron/builder.config.json",
    "preview": "vite preview",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:electron": "playwright test --config playwright.electron.config.ts",
    "test:e2e:greenmail": "RUN_IMAP_GREENMAIL_E2E=1 playwright test --config playwright.electron.config.ts playwright/tests/electron/06-compras-imap-greenmail.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:demo-electron": "playwright test --config playwright.demo-electron.config.ts",
    "lint": "tsc --noEmit",
    "sync-peer": "tsx tools/sync-peer/sync-peer.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.0",
    "imap-simple": "^5.1.0",
    "mailparser": "^3.9.8",
    "node-thermal-printer": "^4.6.1"
  },
  "devDependencies": {
    "@microsoft/applicationinsights-web": "^3.3.0",
    "@microsoft/signalr": "^10.0.11",
    "@playwright/test": "1.61.0",
    "@reduxjs/toolkit": "^2.11.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/crypto-js": "^4.2.0",
    "@types/imap-simple": "^4.2.10",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "axios": "^1.9.0",
    "concurrently": "^9.1.0",
    "crypto-js": "^4.2.0",
    "electron": "^35.2.0",
    "electron-builder": "^26.0.0",
    "fast-xml-parser": "^5.2.0",
    "fflate": "^0.8.3",
    "jest": "^30.0.0",
    "jose": "^6.2.0",
    "lucide-react": "^0.513.0",
    "pdfjs-dist": "^5.7.28",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.5.0",
    "react-router-dom": "^7.5.0",
    "redux-persist": "^6.0.0",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.15",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wait-on": "^8.0.3",
    "xlsx": "^0.18.5"
  }
}
