# Example environment for the Vite build — copy to .env and fill in.
# Only variables prefixed with VITE_ reach the renderer bundle; do not commit .env
# (it is gitignored).

# Google OAuth — Desktop-type OAuth client. The app sends PKCE AND the client
# secret: Google's token endpoint rejects a Desktop client's code exchange
# without it ("client_secret is missing"). A Desktop client's secret is not
# confidential per Google, but keep it out of git anyway (CI writes it from the
# VITE_GOOGLE_CLIENT_SECRET secret). REDIRECT_URI is only used by the web/dev
# popup flow; Electron listens on a random 127.0.0.1 loopback port.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_REDIRECT_URI=

# Chat Soporte — bearer-token auth (optional)
VITE_CHAT_API_URL=

# Invoices.Api origin (optional; defaults to production)
VITE_API_BASE_URL=

# Device Sync v2 relay — Invoices.SyncApi origin (e.g. https://sync.example.com).
# Empty/absent = the Sincronización page reports "no configurado" and no sync
# sessions open. The same value must reach the vite build in CI
# (set it in the CI/build environment from the
# VITE_SYNC_API_URL value).
VITE_SYNC_API_URL=

# SparkleWash carwash API origin (default http://localhost:8080). In browser/dev a
# relative value like /carwash-api uses the Vite proxy (target below).
# NOTE: the API's SPARKLEWASH_GOOGLE_CLIENT_ID must include this desktop app's Google client id.
VITE_SPARKLEWASH_API_URL=
VITE_SPARKLEWASH_API_PROXY_TARGET=

# SparkleWash auto-update feed (generic provider: folder holding latest.yml / latest-mac.yml
# and the installers). Read by the Electron main process at runtime. Empty = updater disabled
# (the app logs and skips). Alternatively bake a feed at build time:
#   npx electron-builder --config electron/builder.config.json -c.publish.provider=generic -c.publish.url=<url>
SPARKLEWASH_UPDATE_URL=
