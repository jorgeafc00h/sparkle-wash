{
  "routes": [
    { "route": "/app", "redirect": "/app/", "statusCode": 301 },
    { "route": "/manual", "redirect": "/manual/", "statusCode": 301 }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/app/*", "/manual/*", "/assets/*", "/landing/*", "/brand/*", "/*.{svg,png,jpg,webp,mp4,webm,vtt,json,ico}"]
  },
  "mimeTypes": { ".vtt": "text/vtt" },
  "globalHeaders": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" }
}
