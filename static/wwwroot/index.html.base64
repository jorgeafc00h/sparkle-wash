<!DOCTYPE html><html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>SparkleWash</title>
<style>
  html{background:#0a0b10;color:#e2e8f0;font-family:system-ui,-apple-system,sans-serif;margin:0}
  body{display:flex;flex-direction:column;height:100vh;overflow:hidden}
  nav{display:flex;align-items:center;padding:.75rem 1.5rem;background:#0f172a;border-bottom:1px solid #334155}
  nav a{color:#e2e8f0;text-decoration:none;margin-right:.75rem;font-weight:600;font-size:.85rem;padding:.5rem .75rem;border-radius:8px;border:1px solid transparent;transition:.15s cubic-bezier(.4,0,.2,1)}
  nav a.active{background:#7c3aed;color:white;border-color:#6d28d9}
  #app{flex:1;display:flex;align-items:center;justify-content:center;text-align:center;padding:1rem;margin-top:0}
  .card{background:rgba(30,41,59,.9);border:1px solid rgba(99,102,241,.3);border-radius:16px;padding:1.5rem;background:#1a1d2e;border-color:#6d28d9}
  .card h2{margin:0;color:#c4b5fd;font-size:1.4rem}
  .card p{color:#94a3b8;font-size:.85rem;margin:.5rem 0 0;color:#647487;}
  .btn{background:linear-gradient(135deg,#7c3aed,#db2777);border:none;color:white;padding:.5rem 1.25rem;border-radius:9999px;font-weight:500;cursor:pointer;transition:transform .1s;display:inline-block;margin:.25rem}
  .btn:hover{transform:scale(1.02)}
</style></head>
<body><nav class="mx-4" style="color:white"><a href="#" id="nav-dashboard" onclick="document.querySelectorAll('nav a').forEach(a=>a.classList.remove('active'));this.classList.add('active')" class="active">Dashboard</a><a href="#" onclick="document.getElementById('app').innerHTML=\'Jobs\'"><span id="tab-jobs">Jobs</span> <small style="font-size:.65rem;color:#94a3b8">12</small></a><a href="#" onclick="document.getElementById('app').innerHTML=\'Employees\'"><span id="tab-employees">Employees</span> <small style="font-size:.65rem;color:#94a3b8">5</small></a></nav><div id="alert-banner" style="position:fixed;bottom:0;left:0;right:0;background:#ef4444;color:white;font-size:.7rem;padding:.5rem;text-align:center;display:none"><span id="alert-text"></span></div><div id="app"><div class="card"><h2>SparkleWash</h2><p>Carwash productivity dashboard v1.0</p><p>Connected to: <a href="http://localhost:8123/api/health" style="color:#7c3aed">API Backend</a></p><button onclick="runInference()" class="btn"><span id="btn-text">Take Photo 📸</span></button><p id="status" style="margin-top:.5rem;color:#94a3b8;font-size:.8rem"></p></div></div><script>
  const API = "http://localhost:8123";
  function runInference(){
    document.getElementById('status').textContent="Uploading...";
    fetch(API+"/api/upload",{{
      headers:{\"Content-Type\":\"application/json\"},
      method:"POST",body:JSON.stringify({station_id:"bay-1",image_data:btoa(escapeString(document.createElement(\'canvas\').toDataURL("\\'/jpeg\\',0.7)).replace(/\\/\\/g,"\\\/").replace(/\\\\/g,"\\/")})
    }})}.then(r=>r.json()).then(d=>{document.getElementById('status').innerHTML=`Success! Plate: \${d.plate_detected || "N/A"} | Car: \${d.car_model} | Type: \${d.job_type}`;document.querySelector('#btn-text').textContent="Scan Again"})();
  }
  function escapeString(s){return s.replace(/\\/g,"\\\\").replace(/\'/g,"\\\'");}
</script></body></html>